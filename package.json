{
  "name": "sulcus-brand-film",
  "version": "1.0.0",
  "description": "Sulcus brand film: Control the agents.",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/media": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.532",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "score": "node --experimental-strip-types --no-warnings scripts/score.ts",
    "render:preview": "npm run score && remotion render SulcusFilm-1080p out/sulcus-brand-film-1080p.mp4 --concurrency=3",
    "render": "npm run score && remotion render SulcusFilm out/sulcus-brand-film-4k.mp4 --concurrency=2",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  }
}
